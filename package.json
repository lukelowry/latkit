{
  "name": "latkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukelowry/latkit.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css,html}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "typecheck:browser": "tsc -p tests/browser/tsconfig.json --noEmit && pnpm --filter @latkit/browser-fixture typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "browser:fixture": "pnpm --filter @latkit/browser-fixture dev",
    "test:browser": "playwright test --project=chromium-engine",
    "test:browser:engines": "playwright test --project=chromium-engine --project=firefox-engine --project=webkit-engine",
    "test:browser:chrome": "playwright test --project=chrome-hardware",
    "test:browser:edge": "playwright test --project=edge-hardware",
    "test:browser:firefox": "start-server-and-test browser:fixture http://127.0.0.1:4178 \"tsx tests/browser/webdriver.ts firefox\"",
    "test:browser:safari": "start-server-and-test browser:fixture http://127.0.0.1:4178 \"tsx tests/browser/webdriver.ts safari\"",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc --options typedoc.json && node scripts/normalize-typedoc-links.mjs",
    "docs:build": "pnpm docs:api && python -m sphinx -W --keep-going -b html docs docs/_build/html",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:browser && pnpm test",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/selenium-webdriver": "4.35.6",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.7.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.4",
    "selenium-webdriver": "4.46.0",
    "start-server-and-test": "3.0.11",
    "tsup": "^8.0.0",
    "tsx": "4.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.0.0"
  }
}
