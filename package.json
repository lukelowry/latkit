{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukelowry/latkit.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css,html}\"",
    "lint": "eslint .",
    "typecheck": "tsc -p npm/test && pnpm --dir npm/examples exec tsc --noEmit && pnpm --dir npm/examples exec tsc -p gate && pnpm --dir benchmark exec tsc -p . && pnpm --dir docs/gallery exec tsc -p .",
    "test": "vitest run && node --test npm/test/data.test.mjs npm/test/jobs.test.mjs npm/test/release.test.mjs npm/test/video.test.mjs",
    "version-packages": "changeset version && cargo xtask version",
    "release": "cargo xtask release"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.0.0"
  }
}
