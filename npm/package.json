    "pkg/latkit_bg.wasm",
    "pkg/latkit_bg.wasm.d.ts"
  ],
  "scripts": {
    "build": "cargo xtask wasm",
    "pack:release": "cargo xtask package"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
