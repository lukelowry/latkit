{
  "name": "latkit",
  "version": "0.1.0",
  "description": "Columnar data drawn as vertices, edges, lines, and areas with WebGPU.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukelowry/latkit.git"
  },
  "exports": {
