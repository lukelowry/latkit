{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "strict": true,
    "declaration": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "dist",
    "stripInternal": true
  },
  "include": ["src"]
}
