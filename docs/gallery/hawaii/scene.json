{
  "space": { "plane": { "grid": "off" } },
  "ease": 0,
  "theme": {
    "base": "light",
    "background": "#ffffff",
    "text": { "font": "Arial, sans-serif", "size": 24, "color": "#171c20", "halo": 0 }
  },
  "marks": [
    {
      "lines": ["hawaii", "Line"],
      "color": {
        "value": "$voltageClass",
        "colormap": {
          "kind": "categorical",
          "colors": ["#36424d", "#9b6a16"],
          "categories": ["69 kV", "138 kV"]
        }
      },
      "width": { "when": [[{ "eq": ["$voltageClass", 1] }, 2.6]], "otherwise": 1.9 }
    },
    { "lines": ["hawaii", "Winding69"], "color": "#36424d", "width": 2.4 },
    { "lines": ["hawaii", "Winding138"], "color": "#9b6a16", "width": 2.4 },
    { "lines": ["hawaii", "Bus69"], "color": "#36424d", "width": 5.6 },
    { "lines": ["hawaii", "Bus138"], "color": "#9b6a16", "width": 6.2 },
    { "lines": ["hawaii", "Load"], "color": "#22292e", "width": 2.05 },
    { "lines": ["hawaii", "Capacitor"], "color": "#22292e", "width": 2.05 },
    { "lines": ["hawaii", "Generator"], "color": "#22292e", "width": 2.05 },
    { "lines": ["hawaii", "OpenGenerator"], "color": "#586169", "width": 1.9 },
    {
      "vertices": ["hawaii", "BusNumber"],
      "position": ["$x", "$y"],
      "radius": 0.1,
      "color": "#00000000",
      "label": { "text": "$text", "size": 26 }
    },
    {
      "lines": ["hawaii", "VoltageKey"],
      "color": {
        "value": "$voltageClass",
        "colormap": { "kind": "categorical", "colors": ["#36424d", "#9b6a16"] }
      },
      "width": { "when": [[{ "eq": ["$voltageClass", 1] }, 6.2]], "otherwise": 5.6 }
    },
    {
      "vertices": ["hawaii", "VoltageKey"],
      "position": ["$x", "$y"],
      "radius": 0.1,
      "color": "#00000000",
      "label": { "text": "$text", "size": 24 }
    }
  ]
}
