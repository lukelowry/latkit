{
  "name": "@latkit/gpu",
  "version": "0.0.0",
  "private": true,
  "description": "Bounded WebGPU rendering and native Latkit column preparation.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "node tests/browser/run.mjs",
    "benchmark": "vitest bench --config vitest.config.ts --run"
  },
  "dependencies": {
    "@latkit/model": "workspace:*",
    "@webgpu/types": "^0.1.71",
    "culori": "4.0.2"
  },
  "devDependencies": {
    "@latkit/connect": "workspace:*",
    "@types/culori": "^4.0.1"
  }
}
