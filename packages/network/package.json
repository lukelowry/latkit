{
  "name": "@latkit/network",
  "version": "0.19.0",
  "description": "Native model network rendering over the shared Latkit GPU pipeline.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukelowry/latkit.git",
    "directory": "packages/network"
  },
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project @latkit/network",
    "test:browser": "pnpm --filter @latkit/network... build && esbuild tests/fixture.ts tests/paths-fixture.ts --format=esm --outdir=dist && node tests/browser/run.mjs --headed --keep-open"
  },
  "dependencies": {
    "@latkit/gpu": "workspace:^",
    "@latkit/model": "workspace:^",
    "@webgpu/types": "^0.1.71"
  },
  "publishConfig": {
    "access": "public"
  }
}
