{
  "name": "@latkit/embed",
  "version": "0.7.0",
  "description": "Self-contained browser embeds for Latkit.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukelowry/latkit.git",
    "directory": "packages/embed"
  },
  "license": "MIT",
  "sideEffects": [
    "./dist/register.js",
    "./dist/embed.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./embed.js": {
      "types": "./dist/register.d.ts",
      "import": "./dist/embed.js"
    },
    "./assets/*": "./dist/assets/*"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsup --config tsup.standalone.config.ts && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project @latkit/embed"
  },
  "dependencies": {
    "@latkit/colormaps": "workspace:*",
    "@latkit/gpu": "workspace:*",
    "@latkit/network": "workspace:*"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "jsdom": "^26.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
