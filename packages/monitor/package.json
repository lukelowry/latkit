{
  "name": "@latkit/monitor",
  "version": "0.8.0",
  "description": "Progressive native observation rendering on the shared Latkit GPU.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukelowry/latkit.git",
    "directory": "packages/monitor"
  },
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "tsup tests/fixture.ts --config false --format esm --out-dir tests/browser/generated --external @latkit/model && node tests/browser/run.mjs"
  },
  "dependencies": {
    "@latkit/model": "workspace:*",
    "@latkit/gpu": "workspace:*"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71"
  },
  "publishConfig": {
    "access": "public"
  }
}
