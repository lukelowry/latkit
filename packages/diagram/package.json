{
  "name": "@latkit/diagram",
  "version": "0.10.0",
  "description": "WebGPU block-diagram renderer and editor surface for Latkit.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukelowry/latkit.git",
    "directory": "packages/diagram"
  },
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project @latkit/diagram",
    "test:browser": "pnpm --filter @latkit/diagram... build && esbuild tests/fixture.ts --format=esm --outfile=../../output/diagram-fixture.js && node tests/browser/run.mjs"
  },
  "dependencies": {
    "@latkit/gpu": "workspace:^",
    "@latkit/model": "workspace:^",
    "@webgpu/types": "^0.1.71"
  },
  "publishConfig": {
    "access": "public"
  }
}
