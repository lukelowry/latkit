{
  "name": "@latkit/network-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @latkit/model --filter @latkit/gpu build && pnpm --filter @latkit/network build",
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "prebuild": "pnpm --filter @latkit/model --filter @latkit/gpu build && pnpm --filter @latkit/network build",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@latkit/model": "workspace:*",
    "@latkit/gpu": "workspace:*",
    "@latkit/network": "workspace:*"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
