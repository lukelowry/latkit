{
  "name": "@latkit/video-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5194 --strictPort",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5194",
    "predev": "pnpm --filter @latkit/model --filter @latkit/gpu build && pnpm --filter @latkit/network --filter @latkit/monitor --filter @latkit/video build",
    "prebuild": "pnpm --filter @latkit/model --filter @latkit/gpu build && pnpm --filter @latkit/network --filter @latkit/monitor --filter @latkit/video build"
  },
  "dependencies": {
    "@latkit/video": "workspace:*",
    "@latkit/gpu": "workspace:*",
    "@latkit/model": "workspace:*",
    "@latkit/network": "workspace:*",
    "@latkit/monitor": "workspace:*"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "mediabunny": "^1.60.0"
  }
}
