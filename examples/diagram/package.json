{
  "name": "@latkit/diagram-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @latkit/model --filter @latkit/colormaps --filter @latkit/gpu build && pnpm --filter @latkit/diagram build",
    "dev": "vite --host 127.0.0.1 --port 5194",
    "prebuild": "pnpm --filter @latkit/model --filter @latkit/colormaps --filter @latkit/gpu build && pnpm --filter @latkit/diagram build",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@latkit/colormaps": "workspace:*",
    "@latkit/diagram": "workspace:*",
    "@latkit/model": "workspace:*"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
